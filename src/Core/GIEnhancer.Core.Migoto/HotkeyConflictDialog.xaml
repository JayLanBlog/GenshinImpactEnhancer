<Window x:Class="GIEnhancer.Core.Migoto.HotkeyConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="热键冲突检测" Height="420" Width="520"
        Background="#1a1a2e" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="⚠️ 热键冲突检测"
                   FontSize="20" FontWeight="Bold" Foreground="#ffd93d"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="检测到以下热键被 ReShade 和 3DMigoto 同时使用："
                   FontSize="12" Foreground="#ccc" Margin="0,0,0,10"/>

        <!-- 冲突列表 -->
        <Border Grid.Row="2" Background="#16213e" CornerRadius="8" Padding="12"
                BorderBrush="#ffd93d" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ConflictList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0f0f23" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <!-- 冲突键名 -->
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#ff6b6b">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}🔑 {0} 键冲突">
                                                <Binding Path="KeyName"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- ReShade 使用 -->
                                    <ItemsControl ItemsSource="{Binding ReShadeUsages}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#0af" Margin="8,0,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 3DMigoto 使用 -->
                                    <ItemsControl ItemsSource="{Binding MigotoUsages}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#0f8" Margin="8,0,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 修改选择 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="修改：" FontSize="11" Foreground="#aaa" VerticalAlignment="Center"/>
                                        <RadioButton Content="ReShade" Tag="reshade" Margin="6,0,0,0"
                                                     Foreground="#0af" FontSize="11" VerticalAlignment="Center"
                                                     GroupName="{Binding KeyName}" Checked="OnModifyTargetChanged"/>
                                        <RadioButton Content="3DMigoto" Tag="migoto" Margin="6,0,0,0"
                                                     Foreground="#0f8" FontSize="11" VerticalAlignment="Center"
                                                     GroupName="{Binding KeyName}" IsChecked="True" Checked="OnModifyTargetChanged"/>
                                        <RadioButton Content="两者都改" Tag="both" Margin="6,0,0,0"
                                                     Foreground="#ffd93d" FontSize="11" VerticalAlignment="Center"
                                                     GroupName="{Binding KeyName}" Checked="OnModifyTargetChanged"/>
                                        <TextBlock Text="  替换为：" FontSize="11" Foreground="#aaa" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <ComboBox x:Name="ReplaceKeyCombo" Width="100" Height="24"
                                                  SelectionChanged="OnReplaceKeyChanged"
                                                  Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 提示 -->
        <TextBlock Grid.Row="3" Text="💡 建议修改 3DMigoto 侧热键，保持 ReShade 默认设置"
                   FontSize="11" Foreground="#666" Margin="0,8,0,0"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="取消启动" Width="120" Height="36"
                    Background="#533483" Foreground="White" BorderThickness="0"
                    FontSize="13" Cursor="Hand" Click="BtnCancel_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button x:Name="BtnApply" Content="应用并启动" Width="140" Height="36"
                    Background="#e94560" Foreground="White" BorderThickness="0"
                    FontSize="13" FontWeight="Bold" Cursor="Hand" Click="BtnApply_Click" Margin="12,0,0,0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
