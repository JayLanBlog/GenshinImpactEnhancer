<Window x:Class="Stella.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Genshin Stella Mod" Height="700" Width="920"
        Background="#1a1a2e" WindowStartupLocation="CenterScreen">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="🎮 Genshin Stella Mod" 
                   FontSize="28" FontWeight="Bold" Foreground="#e94560"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <!-- 游戏路径 -->
        <Border Grid.Row="1" Background="#16213e" CornerRadius="10" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🎯 游戏路径:" VerticalAlignment="Center" 
                           Foreground="#e94560" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtGamePath" Grid.Column="1" VerticalAlignment="Center"
                         Background="#0f0f23" Foreground="#ccc" BorderBrush="#333"
                         FontFamily="Consolas" FontSize="12" Height="30"
                         Text="点击右侧🔍自动搜索，或手动输入原神路径"/>
                <Button x:Name="BtnSearch" Grid.Column="2" Content="🔍 搜索" Width="80" Height="30"
                        Background="#533483" Foreground="White" BorderThickness="0"
                        Margin="8,0,3,0" Cursor="Hand" Click="BtnSearch_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button Grid.Column="3" Content="📂 浏览" Width="70" Height="30"
                        Background="#0f3460" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnBrowse_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- 硬件信息 -->
        <Border Grid.Row="2" Background="#16213e" CornerRadius="10" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="🖥️ 硬件" FontSize="14" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtHardware" Foreground="#ccc" FontSize="12" 
                           Text="正在采集..." FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <!-- 主内容 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧 AI 推荐 -->
            <Border Background="#16213e" CornerRadius="10" Padding="14" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="🤖 AI 推荐" FontSize="14" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtRecommendation" Text="分析中..." Foreground="#ccc" FontSize="12"
                               FontFamily="Consolas" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 右侧 引擎状态 + 运行日志 -->
            <Border Background="#16213e" CornerRadius="10" Padding="14" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="⚙️ 引擎 / 运行日志" FontSize="14" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtLog" Foreground="#aaa" FontSize="12"
                                 FontFamily="Consolas" TextWrapping="Wrap"
                                 Background="#0f0f23" BorderBrush="#333"
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 Text="等待启动..." Height="180"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="注入 DLL: " Foreground="#888" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock x:Name="TxtDllStatus" Text="待检测" Foreground="#ffd93d" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Text=" | " Foreground="#444" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Text="PEB隐藏: " Foreground="#888" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock x:Name="TxtPebStatus" Text="—" Foreground="#ffd93d" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="BtnLaunch" Content="▶ 一键启动增强模式" 
                    Width="230" Height="45" FontSize="15" FontWeight="Bold"
                    Background="#e94560" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="BtnLaunch_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>
            <Button x:Name="BtnShutdown" Content="⏹ 停止" 
                    Width="100" Height="45" FontSize="14"
                    Background="#533483" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="BtnShutdown_Click" IsEnabled="False" Margin="10,0,0,0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>
        </StackPanel>

        <!-- 状态栏 -->
        <TextBlock x:Name="TxtStatus" Grid.Row="4" Text="就绪" 
                   Foreground="#888" FontSize="11" HorizontalAlignment="Left"
                   VerticalAlignment="Bottom" Margin="0,0,0,-3"/>
    </Grid>
</Window>
