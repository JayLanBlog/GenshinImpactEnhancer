<Window x:Class="GIEnhancer.Launcher.MigotoPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3DMigoto Mod 配置面板" Height="580" Width="580"
        Background="#1a1a2e" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" ShowInTaskbar="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="🔧 3DMigoto Mod 配置面板"
                   FontSize="22" FontWeight="Bold" Foreground="#66bb6a"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <!-- 状态卡片 -->
        <Border Grid.Row="1" Background="#16213e" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="状态" FontSize="13" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="初始化: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtInitStatus" Text="未初始化" Foreground="#ffd93d" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="DLL 部署: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtDeployStatus" Text="未部署" Foreground="#ffd93d" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Hunting: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtHunting" Text="关闭" Foreground="#ffd93d" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Mod 数量: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtModCount" Text="0" Foreground="#66bb6a" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="反检测配置" FontSize="13" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Anti-Det: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtAntiDet" Text="检测中..." Foreground="#ffd93d" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="load_lib_redirect: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtLoadLib" Text="—" Foreground="#ccc" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="check_fg_window: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtCheckFg" Text="—" Foreground="#ccc" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="日志: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtLogging" Text="—" Foreground="#ccc" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DLL 文件 -->
        <Border Grid.Row="2" Background="#16213e" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="d3d11.dll" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtD3d11" Text="未检测" Foreground="#ffd93d" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="d3dcompiler_47.dll" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtD3dcompiler" Text="未检测" Foreground="#ffd93d" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="nvapi64.dll" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtNvapi" Text="未检测" Foreground="#ffd93d" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 热键配置 -->
        <Border Grid.Row="3" Background="#16213e" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="⌨️ 热键配置 (d3dx.ini)" FontSize="13" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                <ListView x:Name="LstHotkeys" Grid.Row="1" Background="#0f0f23" BorderBrush="#333"
                          FontSize="12" FontFamily="Consolas" Foreground="#ccc" MaxHeight="160">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="区段" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Section}" Foreground="#ffd93d"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="功能" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Function}" Foreground="#66bb6a"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="键名" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KeyName}" Foreground="#ccc"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Mod 目录信息 -->
        <Border Grid.Row="4" Background="#16213e" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📁 Mod 目录" FontSize="13" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                <ListView x:Name="LstMods" Grid.Row="1" Background="#0f0f23" BorderBrush="#333"
                          FontSize="12" FontFamily="Consolas" Foreground="#ccc">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Mod 名称" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="#66bb6a"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="文件数" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileCount}" Foreground="#ccc"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- 路径信息 -->
        <StackPanel Grid.Row="5" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎮 游戏目录: " Foreground="#888" FontSize="11"/>
                <TextBlock x:Name="TxtGameDir" Text="—" Foreground="#ccc" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="🔧 工具目录: " Foreground="#888" FontSize="11"/>
                <TextBlock x:Name="TxtToolDir" Text="—" Foreground="#ccc" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>

        <!-- 提示 -->
        <TextBlock Grid.Row="6" Text="💡 3DMigoto 通过 d3d11.dll 代理注入，游戏中按 F3 切换 Mod，F10 重载"
                   FontSize="11" Foreground="#666" Margin="0,6,0,0"/>

        <!-- 关闭按钮 -->
        <Button Grid.Row="6" Content="关闭" Width="100" Height="34"
                Background="#533483" Foreground="White" BorderThickness="0"
                FontSize="13" Cursor="Hand" HorizontalAlignment="Right" Margin="0,8,0,0"
                Click="BtnClose_Click">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
        </Button>
    </Grid>
</Window>
