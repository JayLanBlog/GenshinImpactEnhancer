<Window x:Class="GIEnhancer.Launcher.ReshadePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReShade 配置面板" Height="520" Width="560"
        Background="#1a1a2e" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" ShowInTaskbar="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="🎨 ReShade 配置面板"
                   FontSize="22" FontWeight="Bold" Foreground="#4fc3f7"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <!-- 状态卡片 -->
        <Border Grid.Row="1" Background="#16213e" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="状态" FontSize="13" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="初始化: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtInitStatus" Text="未初始化" Foreground="#ffd93d" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="DLL 部署: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtDeployStatus" Text="未部署" Foreground="#ffd93d" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="游戏目录: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtGameDir" Text="—" Foreground="#ccc" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="DLL 文件" FontSize="13" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="dxgi.dll: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtDxgi" Text="未检测" Foreground="#ffd93d" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="ReShade64.dll: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtReShade64" Text="未检测" Foreground="#ffd93d" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="ReShade.ini: " Foreground="#888" FontSize="12"/>
                        <TextBlock x:Name="TxtReShadeIni" Text="未检测" Foreground="#ffd93d" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 预设信息 -->
        <Border Grid.Row="2" Background="#16213e" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="📋 预设信息" FontSize="13" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="当前预设: " Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtActivePreset" Text="无" Foreground="#4fc3f7" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="预设目录: " Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtPresetDir" Text="—" Foreground="#ccc" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 热键配置 -->
        <Border Grid.Row="3" Background="#16213e" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="⌨️ 热键配置 (ReShade.ini)" FontSize="13" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,6"/>
                <ListView x:Name="LstHotkeys" Grid.Row="1" Background="#0f0f23" BorderBrush="#333"
                          FontSize="12" FontFamily="Consolas" Foreground="#ccc">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="功能" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Function}" Foreground="#4fc3f7"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="键名" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KeyName}" Foreground="#ccc"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="虚拟键码" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VkCode}" Foreground="#888"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- 工具目录 -->
        <Border Grid.Row="4" Background="#16213e" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔧 工具目录: " Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtToolDir" Text="—" Foreground="#ccc" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- 提示 -->
        <TextBlock Grid.Row="5" Text="💡 ReShade 通过 dxgi.dll 代理注入，游戏中按 Home 键打开 ReShade 菜单"
                   FontSize="11" Foreground="#666" Margin="0,4,0,0"/>

        <!-- 关闭按钮 -->
        <Button Grid.Row="6" Content="关闭" Width="100" Height="34"
                Background="#533483" Foreground="White" BorderThickness="0"
                FontSize="13" Cursor="Hand" HorizontalAlignment="Center" Margin="0,8,0,0"
                Click="BtnClose_Click">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
        </Button>
    </Grid>
</Window>
